                  "    pm.expect(json.data).to.have.property(\"byCategory\");",
                  "    pm.expect(json.data).to.have.property(\"count\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Expenses - Delete",
      "item": [
        {
          "name": "Delete Expense - Existing",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/expenses/{{expenseId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses",
                "{{expenseId}}"
              ]
            },
            "description": "Deletes the expense created by \"Create Expense - Valid\" (uses the expenseId collection variable set by that request's test script). Run that request first."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 204\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "",
                  "pm.test(\"Response body is empty\", function () {",
                  "    pm.expect(pm.response.text()).to.eql(\"\");",
                  "});"
                ]
              }
            }
          ]
        },
