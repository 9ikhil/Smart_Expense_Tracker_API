{
  "info": {
    "_postman_id": "e8999a46-4c3a-4b37-9738-72483887d3c6",
    "name": "Smart Expense Tracker API",
    "description": "REST API for tracking personal expenses (add, list, filter by category, summarize totals, delete). Backed by a local JSON file, no database.\n\nImport this collection, set the `baseUrl` variable (defaults to http://localhost:3000), and run \"Create Expense - Valid\" first so its response id gets saved into the `expenseId` collection variable, which \"Delete Expense - Existing\" then uses.\n\nRequests are grouped to mirror the API's test suite: happy paths, then validation failure cases, then not-found cases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "expenseId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Basic liveness check for the API."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response indicates the API is healthy\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.status).to.eql(\"ok\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Expenses - Create",
      "item": [
        {
          "name": "Create Expense - Valid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/expenses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses"
              ]
            },
            "description": "Creates a new expense. On success, saves the returned id into the `expenseId` collection variable for later requests (e.g. Delete Expense - Existing).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Groceries\",\n  \"amount\": 42.5,\n  \"category\": \"Food\",\n  \"date\": \"2026-01-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"Response contains the created expense\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data).to.have.property(\"id\");",
                  "    pm.expect(json.data.title).to.eql(\"Groceries\");",
                  "    pm.expect(json.data.amount).to.eql(42.5);",
                  "    pm.expect(json.data.category).to.eql(\"Food\");",
                  "",
                  "    // Save the id so later requests (e.g. Delete Expense - Existing) can use it.",
                  "    pm.collectionVariables.set(\"expenseId\", json.data.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Expense - Missing Title (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/expenses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses"
              ]
            },
            "description": "Omits the required title field - should be rejected with 400.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 10,\n  \"category\": \"Food\",\n  \"date\": \"2026-01-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Error mentions title\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(false);",
                  "    pm.expect(json.message.toLowerCase()).to.include(\"title\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Expense - Negative Amount (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/expenses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses"
              ]
            },
            "description": "Amount must be positive - should be rejected with 400.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Refund\",\n  \"amount\": -5,\n  \"category\": \"Food\",\n  \"date\": \"2026-01-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Error mentions amount\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.message.toLowerCase()).to.include(\"amount\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Expense - Amount as String (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/expenses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses"
              ]
            },
            "description": "The API requires amount to be a JSON number, not a numeric string. This is a deliberate strictness decision - see AI_NOTES.md.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Coffee\",\n  \"amount\": \"4.5\",\n  \"category\": \"Food\",\n  \"date\": \"2026-01-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Expense - Invalid Date (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/expenses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses"
              ]
            },
            "description": "date must be a valid ISO date string - should be rejected with 400.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Coffee\",\n  \"amount\": 4.5,\n  \"category\": \"Food\",\n  \"date\": \"not-a-date\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 400\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Error mentions date\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.message.toLowerCase()).to.include(\"date\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Expenses - Read",
      "item": [
        {
          "name": "Get All Expenses",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/expenses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses"
              ]
            },
            "description": "Returns every expense currently stored."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response data is an array\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(Array.isArray(json.data)).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Expenses by Category",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/expenses?category=Food",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "expenses"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "Food"
                }
              ]
            },
            "description": "Filters expenses by category (case-insensitive)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Every returned expense matches the category filter\", function () {",
                  "    const json = pm.response.json();",
                  "    json.data.forEach((expense) => {",
                  "        pm.expect(expense.category.toLowerCase()).to.eql(\"food\");",
                  "    });",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
